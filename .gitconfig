[user]
	name = Vehnusian
	# email = your-email@example.com  # uncomment and set this

[init]
	defaultBranch = main

[core]
	autocrlf = true
	editor = code --wait
	excludesFile = ~/.gitignore_global
	longpaths = true
	# Prevent large files from being committed accidentally
	bigFileThreshold = 50m

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictStyle = zdiff3
	tool = code

[diff]
	algorithm = histogram
	colorMoved = default

[rerere]
	enabled = true

[alias]
	s = status --short --branch
	lg = log --oneline --graph --decorate -20
	lga = log --oneline --graph --decorate --all -30
	last = log -1 --stat
	undo = reset --soft HEAD~1
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	branches = branch -a --sort=-committerdate
	stash-all = stash push --include-untracked
	cleanup = !git branch --merged main | grep -v 'main' | xargs -n 1 git branch -d

[color]
	ui = auto

[credential]
	helper = manager

[safe]
	directory = *
